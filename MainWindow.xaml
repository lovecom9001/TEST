<Window x:Class="PDFEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PDFEditor"
        mc:Ignorable="d"
        Title="PDF 편집기"
        Height="800"
        Width="1400"
        Background="{StaticResource BackgroundBrush}">

    <Window.DataContext>
        <local:MainViewModel/>
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 상단 툴바 -->
        <Border Grid.Row="0"
                Background="{StaticResource SecondaryBrush}"
                BorderBrush="#374151"
                BorderThickness="0,0,0,1"
                Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                          Text="PDF 편집기"
                          FontSize="20"
                          FontWeight="Bold"
                          Foreground="{StaticResource TextBrush}"
                          VerticalAlignment="Center"/>

                <StackPanel Grid.Column="2"
                           Orientation="Horizontal"
                           HorizontalAlignment="Right">
                    <Button Content="📁 PDF 열기"
                            Style="{StaticResource ModernButton}"
                            Margin="0,0,8,0"
                            Click="OpenPDF_Click"/>
                    <Button Content="💾 저장"
                            Style="{StaticResource ModernButton}"
                            Click="SavePDF_Click"
                            IsEnabled="{Binding IsPdfLoaded}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 메인 컨텐츠 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 왼쪽 사이드바 -->
            <Border Grid.Column="0"
                    Background="{StaticResource SecondaryBrush}"
                    BorderBrush="#374151"
                    BorderThickness="0,0,1,0"
                    Padding="16">
                <StackPanel>
                    <TextBlock Text="도구"
                              FontSize="14"
                              FontWeight="SemiBold"
                              Foreground="#9CA3AF"
                              Margin="0,0,0,12"/>

                    <Button Content="🖱️ 선택"
                            Style="{StaticResource ToolButton}"
                            Tag="Select"
                            Click="Tool_Click"/>
                    <Button Content="✏️ 텍스트"
                            Style="{StaticResource ToolButton}"
                            Tag="Text"
                            Click="Tool_Click"/>
                    <Button Content="🖼️ 이미지"
                            Style="{StaticResource ToolButton}"
                            Tag="Image"
                            Click="Tool_Click"/>
                    <Button Content="▭ 사각형"
                            Style="{StaticResource ToolButton}"
                            Tag="Rectangle"
                            Click="Tool_Click"/>
                    <Button Content="○ 원"
                            Style="{StaticResource ToolButton}"
                            Tag="Circle"
                            Click="Tool_Click"/>
                    <Button Content="✍️ 서명"
                            Style="{StaticResource ToolButton}"
                            Tag="Signature"
                            Click="Tool_Click"/>

                    <Separator Margin="0,16" Background="#374151"/>

                    <Button Content="↩ 실행 취소"
                            Style="{StaticResource ToolButton}"
                            Click="Undo_Click"
                            IsEnabled="{Binding IsPdfLoaded}"/>
                    <Button Content="🔍 OCR 인식"
                            Style="{StaticResource ToolButton}"
                            x:Name="OcrButton"
                            Click="OCR_Click"
                            IsEnabled="{Binding IsPdfLoaded}"/>
                    <Button Content="✅ OCR → 주석 적용"
                            Style="{StaticResource ToolButton}"
                            Click="ApplyOcr_Click"
                            IsEnabled="{Binding IsPdfLoaded}"/>
                    <Button Content="🗑️ OCR 초기화"
                            Style="{StaticResource ToolButton}"
                            Click="ClearOcr_Click"
                            IsEnabled="{Binding IsPdfLoaded}"/>

                    <Separator Margin="0,16" Background="#374151"/>

                    <TextBlock Text="색상"
                              FontSize="14"
                              FontWeight="SemiBold"
                              Foreground="#9CA3AF"
                              Margin="0,0,0,8"/>
                    <ComboBox x:Name="ColorPicker"
                             Height="40"
                             Background="{StaticResource SurfaceBrush}"
                             Foreground="{StaticResource TextBrush}"
                             BorderBrush="#374151">
                        <ComboBoxItem Content="검정" Tag="#000000" IsSelected="True"/>
                        <ComboBoxItem Content="빨강" Tag="#EF4444"/>
                        <ComboBoxItem Content="파랑" Tag="#3B82F6"/>
                        <ComboBoxItem Content="초록" Tag="#10B981"/>
                    </ComboBox>

                    <TextBlock Text="글자 크기"
                              FontSize="14"
                              FontWeight="SemiBold"
                              Foreground="#9CA3AF"
                              Margin="0,16,0,8"/>
                    <Slider x:Name="FontSizeSlider"
                           Minimum="10"
                           Maximum="72"
                           Value="16"
                           TickFrequency="2"
                           IsSnapToTickEnabled="True"/>
                    <TextBlock Text="{Binding ElementName=FontSizeSlider, Path=Value, StringFormat={}{0:F0}px}"
                              Foreground="#9CA3AF"
                              HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- PDF 뷰어 영역 -->
            <Grid Grid.Column="1" Background="#0F172A">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" x:Name="PdfViewerContainer"
                        Margin="32"
                        Background="White"
                        CornerRadius="8"
                        Effect="{DynamicResource DropShadow}">
                    <Grid>
                        <!-- PDF 표시 영역 -->
                        <Image x:Name="PdfImageView"
                              Stretch="Uniform"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>

                        <!-- 빈 상태 메시지 -->
                        <StackPanel x:Name="EmptyState"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding IsPdfLoaded, Converter={StaticResource InverseBoolToVisConverter}}">
                            <TextBlock Text="PDF 파일을 업로드하세요"
                                      FontSize="24"
                                      Foreground="#6B7280"
                                      HorizontalAlignment="Center"/>
                            <TextBlock Text="상단의 'PDF 열기' 버튼을 클릭하세요"
                                      FontSize="14"
                                      Foreground="#9CA3AF"
                                      Margin="0,8,0,0"
                                      HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- 주석 캔버스 -->
                        <Canvas x:Name="AnnotationCanvas"
                               Background="Transparent"
                               MouseLeftButtonDown="Canvas_MouseLeftButtonDown"/>
                    </Grid>
                </Border>

                <!-- 페이지 네비게이션 -->
                <StackPanel Grid.Row="0"
                           Orientation="Horizontal"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Bottom"
                           Margin="0,0,0,32"
                           Visibility="{Binding IsPdfLoaded, Converter={StaticResource BoolToVisConverter}}">
                    <Border Background="{StaticResource SecondaryBrush}"
                           CornerRadius="8"
                           Padding="16,12">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="◀ 이전"
                                   Style="{StaticResource ModernButton}"
                                   Margin="0,0,8,0"
                                   Click="PreviousPage_Click"
                                   IsEnabled="{Binding CanGoPrevious}"/>
                            <TextBlock x:Name="PageInfo"
                                      Text="1 / 1"
                                      Foreground="{StaticResource TextBrush}"
                                      VerticalAlignment="Center"
                                      Margin="16,0"/>
                            <Button Content="다음 ▶"
                                   Style="{StaticResource ModernButton}"
                                   Margin="8,0,0,0"
                                   Click="NextPage_Click"
                                   IsEnabled="{Binding CanGoNext}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

            </Grid>
        </Grid>
    </Grid>
</Window>
